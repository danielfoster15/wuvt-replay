# Host-specific settings for docker-compose. Copy to `.env` (untracked, next to
# docker-compose.yml) on the deploy host and fill in. Anything left unset makes
# the matching /health check report "not configured".

# Nextcloud status endpoint for the /health screen, e.g.
# http://host.docker.internal:<port>/status.php
NEXTCLOUD_STATUS_URL=

# Mount point (inside the container) of the external drive to watch, matching
# the volume in docker-compose.yml.
EXPANSION_PATH=/external/expansion
